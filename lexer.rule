
#KEYWORDS
let:\blet\b
fn:\bfn\b
if:\bif\b
else:\belse\b
while:\bwhile\b
break:\bbreak\b
return:\breturn\b
continue:\bcontinue\b
include:\binclude\b
#TYPEKW
int:\bint\b
string_typekw:\bstring\b
char_typekw:\bchar\b
void:\bvoid\b
struct:\bstruct\b
#NUMBER
number:(0x[0-9a-fA-F]+)|([0-9a-fA-F]+h)|(0b[01]+)|(0o[1-7]+)|([01]+b)|([0-9]+)
float:[0-9]+.[0-9]+
#STRING
string:\"[^\"]*\"
#CHAR
char:\'\\?[^\']?\'
#IDENTIFIER
identifier:[a-zA-Z_][a-zA-Z_0-9]*
#OPERATOR
addassign:\+=
minusassign:-=
mulassign:\*=
divassign:/=
modassign:\%=
bitandassign:&=
bitorassign:\|=
shiftleftassign:<<=
shiftrightassign:>>=
greaterequal:>=
lessequal:<=
equal:==
assign:=
unequal:!=
shiftleft:<<
shiftright:>>
or:\|\|
greaterthan:>
lessthan:<
add:\+
minus:-
star:\*
slash:/
percent:\%
property:\.
openparen:\(
closedparen:\)
and:&&
not:\!
bitand:&
bitor:\|
bitnot:~
bitxor:\^
comma:\,
open_squaredbracket:\[
closed_squaredbracket:\]

~BI_OPERATOR
add:
minus:
star:
slash:
and:
or:
not:
bitand:
bitor:
bitxor:
property:
percent:
unequal:
greaterthan:
lessthan:
greaterequal:
lessequal:
shiftleft:
shiftright:
addassign:
minusassign:
mulassign:
divassign:
modassign:
bitandassign:
bitorassign:
shiftleftassign:
shiftrightassign:

~SINGLE_OPERATOR
add:
minus:
star:
not:
bitnot:
bitand:

#SEPARATOR
openbracket:\{
closedbracket:\}
semicolon:;
colon::
#COMMENT
line_comment://.*
block_comment:/\*(.|\n)*\*/
#WHITESPACE
whitespace:\s+