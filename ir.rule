term.factor:
    temp %result
    visit expr %result
    yield %result

single_op_factor.bitnot:
    temp %operand
    temp %result
    visit expr %operand
    bitnot %operand %result
    yield %result
single_op_factor.neg:
    temp %operand
    temp %result
    visit expr %operand
    minus %operand %result
    yield %result
single_op_factor.ref:
    temp %result
    visit_ref expr %result
    yield %result
single_op_factor.deref:
    temp %pointer
    temp %result
    visit expr %pointer
    deref %pointer %result
    yield %result
single_op_factor.not:
    temp %operand
    temp %result
    visit expr %operand
    negate %operand %result
    yield %result
single_op_factor.none:
    temp %result
    visit expr %result
    yield %result

power_factor.pow:
    temp %left
    temp %right
    temp %left_converted
    temp %right_converted
    temp %result
    visit left %left
    visit right %right
    cast $conversion(left) %left %left_converted
    cast $conversion(right) %right %right_converted
    bitxor %left_converted %right_converted %result
    yield %result
power_factor.none:
    temp %result
    visit expr %result
    yield %result
glued_factor.paren:
    temp %result
    visit expr %result
    yield %result
glued_factor.value:
    temp %result
    visit value %result
    yield %result
ultimate_expr.def:
    temp %result
    visit expr %result
    yield %result

statement.expr:
    temp %unused
    visit expr %unused
    yield_none
statement.return_empty:
    return_none
    yield_none
statement.return_sth:
    temp %value
    temp %converted
    visit value %value
    cast $conversion(value) %value %converted
    return %converted
    yield_none
