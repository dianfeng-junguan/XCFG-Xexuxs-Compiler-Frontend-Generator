definition.deftype:
    temp %value
    temp %converted
    temp %address
    alloc $sym %address
    visit value %value
    cast $conversion(value) %value %converted
    store %address %converted
    yield_none
definition.defntype:
    temp %value
    temp %address
    alloc $sym %address
    visit value %value
    store %address %value
    yield_none

declaration.varntype:
    temp %address
    alloc $sym %address
    yield_none
declaration.var:
    temp %address
    alloc $sym %address
    yield_none

assign_expr.assign:
    temp %address
    temp %right
    temp %converted
    visit_ref left %address
    visit right %right
    cast $conversion(right) %right %converted
    store %address %converted
    yield %converted
assign_expr.plus_assign:
    temp %address
    temp %left
    temp %right
    temp %left_converted
    temp %right_converted
    temp %result
    visit_ref left %address
    load %address %left
    visit right %right
    cast $conversion(left) %left %left_converted
    cast $conversion(right) %right %right_converted
    add %left_converted %right_converted %result
    store %address %result
    yield %result
assign_expr.minus_assign:
    temp %address
    temp %left
    temp %right
    temp %left_converted
    temp %right_converted
    temp %result
    visit_ref left %address
    load %address %left
    visit right %right
    cast $conversion(left) %left %left_converted
    cast $conversion(right) %right %right_converted
    sub %left_converted %right_converted %result
    store %address %result
    yield %result
