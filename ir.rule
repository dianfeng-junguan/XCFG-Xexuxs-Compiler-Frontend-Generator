logic_expr_eq.none:
    temp %result
    visit expr %result
    yield %result

logic_expr_or.or:
    temp %left
    temp %result
    visit left %left
    if %left #true #right
    label #true
    or %left %left %result
    goto #end
    label #right
    visit right %result
    goto #end
    label #end
    yield %result
logic_expr_or.none:
    temp %result
    visit expr %result
    yield %result
logic_expr_and.and:
    temp %left
    temp %result
    visit left %left
    if %left #right #false
    label #right
    visit right %result
    goto #end
    label #false
    and %left %left %result
    goto #end
    label #end
    yield %result
logic_expr_and.none:
    temp %result
    visit expr %result
    yield %result

