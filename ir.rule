assign_expr.logic_expr:
    temp %result
    visit expr %result
    yield %result

logic_expr_eq.eq:
    temp %left
    temp %right
    temp %left_converted
    temp %right_converted
    temp %result
    visit left %left
    visit right %right
    cast $conversion(left) %left %left_converted
    cast $conversion(right) %right %right_converted
    equ %left_converted %right_converted %result
    yield %result
logic_expr_eq.neq:
    temp %left
    temp %right
    temp %left_converted
    temp %right_converted
