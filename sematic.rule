[predeclare]
declaration.fn:
    enter predeclare_function(name,args,return_type)
declaration.struct:
    enter predeclare_struct(name)
function.default:
    enter predeclare_function(name,args,return_type)
struct.default:
    enter predeclare_struct(name)

[resolve]
function.default:
    enter enter_function_scope()
    enter declare_parameters(args)
    children return_type stmts
    leave leave_scope()
struct.default:
    enter enter_struct_scope()
    enter declare_members(members)
    children members
    leave leave_scope()
definition.deftype:
    children def_type value
    leave declare_variable(name,def_type)
definition.defntype:
    children value
    leave declare_inferred_variable(name,value)
declaration.varntype:
    leave declare_variable(name)
declaration.var:
    children def_type
    leave declare_variable(name,def_type)
declaration.fn:
    children args return_type
    leave resolve_function_signature(name,args,return_type)
declaration.struct:
    children members
    leave resolve_struct_signature(name,members)
factor.id:
    leave resolve_symbol(value)
glued_factor.def:
    children left
    leave resolve_member(left,right)
glued_factor.call:
    children left args
    leave resolve_arguments(args)
lvalue.prop:
    children left
    leave resolve_member(left,right)
lvalue_noproperty.id:
    leave resolve_symbol(id)
if.default:
    enter enter_block_scope()
    children condition statements rest_block
    leave leave_scope()
while.default:
    enter enter_loop_scope()
    children condition statements
    leave leave_scope()
else.default:
    enter enter_block_scope()
    children statements
    leave leave_scope()
elseif.default:
    enter enter_block_scope()
    children condition statements
    leave leave_scope()
statement.definition:
    children def
statement.expr:
    children expr
statement.declaration:
    children decl_stmt
statement.if:
    children if_stmt
statement.while:
    children while_stmt
statement.return_sth:
    children value

[typecheck]
definition.deftype:
    children def_type value
    leave check_assignable(def_type,value) mark_initialized(name)
definition.defntype:
    children value
    leave infer_variable_type(name,value) mark_initialized(name)
assign_expr.assign:
    children left right
    leave require_modifiable_lvalue(left) check_assignable(left,right)
assign_expr.plus_assign:
    children left right
    leave require_modifiable_lvalue(left) check_addable(left,right)
assign_expr.minus_assign:
    children left right
    leave require_modifiable_lvalue(left) check_minusable(left,right)
assign_expr.mul_assign:
    children left right
    leave require_modifiable_lvalue(left) check_mulable(left,right)
assign_expr.div_assign:
    children left right
    leave require_modifiable_lvalue(left) check_divable(left,right)
assign_expr.mod_assign:
    children left right
    leave require_modifiable_lvalue(left) check_modable(left,right)
assign_expr.bitand_assign:
    children left right
    leave require_modifiable_lvalue(left) check_bitandable(left,right)
assign_expr.bitor_assign:
    children left right
    leave require_modifiable_lvalue(left) check_bitorable(left,right)
assign_expr.shiftleft_assign:
    children left right
    leave require_modifiable_lvalue(left) check_shiftleftable(left,right)
assign_expr.shiftright_assign:
    children left right
    leave require_modifiable_lvalue(left) check_shiftrightable(left,right)
logic_expr_eq.eq:
    children left right
    leave check_equalable(left,right) set_boolean_type()
logic_expr_eq.neq:
    children left right
    leave check_nequalable(left,right) set_boolean_type()
logic_expr_eq.gt:
    children left right
    leave check_comparable(left,right) set_boolean_type()
logic_expr_eq.lt:
    children left right
    leave check_comparable(left,right) set_boolean_type()
logic_expr_eq.ge:
    children left right
    leave check_comparable(left,right) set_boolean_type()
logic_expr_eq.le:
    children left right
    leave check_comparable(left,right) set_boolean_type()
logic_expr_or.or:
    children left right
    leave require_boolean(left) require_boolean(right) set_boolean_type()
logic_expr_and.and:
    children left right
    leave require_boolean(left) require_boolean(right) set_boolean_type()
expr.add:
    children left right
    leave check_addable(left,right) infer_binary_result_type(left,right)
expr.sub:
    children left right
    leave check_minusable(left,right) infer_binary_result_type(left,right)
term.mul:
    children left right
    leave check_mulable(left,right) infer_binary_result_type(left,right)
term.div:
    children left right
    leave check_divable(left,right) infer_binary_result_type(left,right)
term.mod:
    children left right
    leave check_modable(left,right) infer_binary_result_type(left,right)
term.bitand:
    children left right
    leave check_bitandable(left,right) infer_binary_result_type(left,right)
term.bitor:
    children left right
    leave check_bitorable(left,right) infer_binary_result_type(left,right)
term.shiftleft:
    children left right
    leave check_shiftleftable(left,right) infer_binary_result_type(left,right)
term.shiftright:
    children left right
    leave check_shiftrightable(left,right) infer_binary_result_type(left,right)
power_factor.pow:
    children left right
    leave require_numeric(left) require_numeric(right) infer_binary_result_type(left,right)
single_op_factor.bitnot:
    children expr
    leave require_numeric(expr) propagate_type(expr)
single_op_factor.neg:
    children expr
    leave require_numeric(expr) propagate_type(expr)
single_op_factor.ref:
    children expr
    leave require_lvalue(expr) infer_pointer_type(expr)
single_op_factor.deref:
    children expr
    leave require_pointer(expr) infer_pointee_type(expr)
single_op_factor.not:
    children expr
    leave require_boolean(expr) set_boolean_type()
lvalue_noproperty.deref:
    children derefee
    leave require_pointer(derefee) infer_pointee_type(derefee)
glued_factor.call:
    children left args
    leave require_callable(left) check_argument_count(left,args) check_argument_types(left,args) infer_call_result_type(left)
glued_factor.def:
    children left
    leave check_member_access(left,right) propagate_member_type(left,right)
lvalue.prop:
    children left
    leave check_member_access(left,right) propagate_member_type(left,right)
factor.id:
    leave propagate_symbol_type(value)
factor.num:
    leave set_number_type(value)
factor.ch:
    leave set_char_type(value)
factor.str:
    leave set_string_type(value)
glued_factor.value:
    children value
    leave propagate_type(value)
glued_factor.paren:
    children expr
    leave propagate_type(expr)
expr.term:
    children expr
    leave propagate_type(expr)
power_factor.none:
    children expr
    leave propagate_type(expr)
single_op_factor.none:
    children expr
    leave propagate_type(expr)
ultimate_expr.def:
    children expr
    leave propagate_type(expr)
composed_type.paren:
    children inner_type
    leave check_valid_type(inner_type)
composed_type.ptr:
    children pointer_type
    leave check_valid_type(pointer_type)
composed_type.nsizedarr:
    children element_type
    leave check_valid_type(element_type)
composed_type.sizedarr:
    children element_type array_size
    leave check_valid_type(element_type) require_integer(array_size) require_constant_expression(array_size) require_positive(array_size)
statement.return_empty:
    leave require_function_context() check_empty_return_type()
statement.return_sth:
    children value
    leave require_function_context() check_match_return_type(value)

[flow]
function.default:
    children stmts
    leave require_all_paths_return(stmts)
if.default:
    children condition statements rest_block
    leave check_control_flow(condition,statements,rest_block)
while.default:
    children condition statements
    leave check_control_flow(condition,statements)
    leave leave_loop_scope()
statement.break:
    leave require_loop_context()
statement.continue:
    leave require_loop_context()
statement.return_empty:
    leave require_function_context()
statement.return_sth:
    leave require_function_context()
statements.multistmt:
    children stmt other_stmts
    leave check_unreachable(stmt,other_stmts)
